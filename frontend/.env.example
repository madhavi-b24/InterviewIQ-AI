# Copy to .env.development / .env.production as needed — never commit the
# real files (see the root .gitignore). Vite only exposes variables
# prefixed VITE_ to client code (see src/lib/env.ts).

# Base URL of the backend API, including the /api/v1 prefix — matches
# backend/app/main.py's router mount point exactly.
VITE_API_BASE_URL=http://localhost:8000/api/v1
