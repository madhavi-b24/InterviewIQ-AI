# Copy to .env and fill in real values for local development.
# See app/core/config.py for the full list of fields and their defaults.

ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

DATABASE_URL=postgresql+asyncpg://interviewiq:interviewiq@localhost:5432/interviewiq
REDIS_URL=redis://localhost:6379/0

CHROMA_HOST=localhost
CHROMA_PORT=8001

JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_PROVIDER=console

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

CODE_EXECUTION_BACKEND=docker_sandbox
JOB_RUNNER_BACKEND=background_tasks

# --- Resume Intelligence (Module 3) ---
RESUME_STORAGE_BACKEND=local
RESUME_STORAGE_LOCAL_DIR=./data/resumes
RESUME_MAX_UPLOAD_MB=5
RESUME_INTELLIGENCE_PROVIDER=gemini
RESUME_INTELLIGENCE_TIMEOUT_SECONDS=45
RESUME_EMBEDDING_PROVIDER=gemini

# --- Interview Engine (Module 5) ---
INTERVIEW_ENGINE_PROVIDER=gemini
INTERVIEW_ENGINE_TIMEOUT_SECONDS=45

# --- Code Execution Subsystem (Module 6) ---
# EXECUTOR_BASE_URL points at the sibling `executor` container started by
# docker-compose.yml — never a Docker socket, never the host, never the
# main app container (see docs/Architecture.md §6).
EXECUTOR_BASE_URL=http://executor:8100
CODE_EXECUTION_TIMEOUT_SECONDS=10
CODE_EXECUTION_MEMORY_LIMIT_MB=256
CODE_EXECUTION_MAX_OUTPUT_BYTES=65536
CODE_EVALUATION_PROVIDER=gemini
CODE_EVALUATION_TIMEOUT_SECONDS=45
