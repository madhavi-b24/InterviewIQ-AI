# Copy to .env and fill in real values for local development.
# See app/core/config.py for the full list of fields and their defaults.

ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

DATABASE_URL=postgresql+asyncpg://interviewiq:interviewiq@localhost:5432/interviewiq
REDIS_URL=redis://localhost:6379/0

CHROMA_HOST=localhost
CHROMA_PORT=8001

JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GEMINI_API_KEY=

CODE_EXECUTION_BACKEND=docker_sandbox
JOB_RUNNER_BACKEND=background_tasks
